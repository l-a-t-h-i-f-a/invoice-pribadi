rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya pengguna yang sudah login yang boleh membaca & menulis data
    match /{collection}/{docId} {
      allow read, write: if request.auth != null
        && collection in ['karyawan', 'slipGaji', 'tagihan', 'pelunasanGaji', 'pengguna'];
    }
  }
}
